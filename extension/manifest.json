{
  "manifest_version": 3,
  "name": "Fleuve — lien navigateur",
  "short_name": "Fleuve",
  "version": "0.3.1",
  "description": "Envoie les téléchargements et les vidéos détectées à l'application Fleuve sur votre Mac.",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "cookies",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Fleuve",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "overlay.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
